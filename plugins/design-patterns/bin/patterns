#!/usr/bin/env python3
"""Search the bundled Markdown-backed design-pattern catalog."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from pattern_catalog import (
    attach_language,
    entry_search_text,
    load_catalog,
    load_language_profiles,
    load_patterns,
    load_playbooks,
    load_smells,
    matches_scope,
    scope_names,
)


def emit(value: object, as_json: bool, language: str | None = None) -> None:
    if as_json:
        print(json.dumps(value, indent=2, sort_keys=True))
        return
    if isinstance(value, list):
        for item in value:
            if isinstance(item, dict):
                print(f"{item.get('slug')}: {item.get('name')} [{item.get('domain')}]")
            else:
                print(item)
        return
    if isinstance(value, dict):
        if isinstance(value.get("languages"), dict):
            for slug, profile in value["languages"].items():
                print(f"{slug}: {profile['displayName']}")
            return
        if "domains" in value:
            print("Groups:")
            for group in value["groups"]:
                print(f"- {group}")
            print("Domains:")
            for domain in value["domains"]:
                print(f"- {domain}")
            return
        if "displayName" in value and "slug" in value and "name" not in value:
            print(f"{value['slug']}: {value['displayName']}")
            if value.get("objectDesignIdioms"):
                print("Object design idioms:")
                for item in value["objectDesignIdioms"]:
                    print(f"- {item}")
            if value.get("integrationStacks"):
                print("Integration stacks:")
                for item in value["integrationStacks"]:
                    print(f"- {item}")
            return
        print(f"{value.get('name')} ({value.get('slug')})")
        if value.get("kind"):
            print(f"Kind: {value['kind']}")
        if value.get("domain"):
            print(f"Domain: {value['domain']}")
        if value.get("category"):
            print(f"Category: {value['category']}")
        if value.get("groups"):
            print("Groups: " + ", ".join(value["groups"]))
        if value.get("languages"):
            print("Languages: " + ", ".join(value["languages"]))
        if value.get("qualityAttributes"):
            print("Quality attributes: " + ", ".join(value["qualityAttributes"]))
        if value.get("implementationComplexity"):
            print(f"Implementation complexity: {value['implementationComplexity']}")
        if value.get("operationalRisk"):
            print(f"Operational risk: {value['operationalRisk']}")
        if value.get("intent"):
            print(f"Intent: {value['intent']}")
        if value.get("symptom"):
            print(f"Symptom: {value['symptom']}")
        if value.get("whyItMatters"):
            print(f"Why it matters: {value['whyItMatters']}")
        if language and value.get("languageNote"):
            print(f"{language}: {value['languageNote']}")
        elif value.get("languageNotes"):
            print("Language notes: " + ", ".join(sorted(value["languageNotes"])))
        for field, label in (
            ("whenToUse", "When to use"),
            ("avoidWhen", "Avoid when"),
            ("forces", "Forces"),
            ("tradeoffNotes", "Tradeoffs"),
            ("failureModeNotes", "Failure modes"),
            ("testing", "Testing"),
            ("observability", "Observability"),
            ("implementationNotes", "Implementation notes"),
            ("patternSet", "Pattern set"),
            ("implementationSteps", "Implementation steps"),
            ("verification", "Verification"),
            ("patternResponses", "Pattern responses"),
            ("checks", "Checks"),
        ):
            if value.get(field):
                print(f"{label}:")
                for item in value[field]:
                    print(f"- {item}")
        if value.get("patterns"):
            print("Patterns: " + ", ".join(value["patterns"]))
        if value.get("smells"):
            print("Smells: " + ", ".join(value["smells"]))
        if value.get("related"):
            print("Related: " + ", ".join(value["related"]))
        if value.get("relationshipTypes"):
            print("Relationships:")
            for kind, slugs in sorted(value["relationshipTypes"].items()):
                print(f"- {kind}: {', '.join(slugs)}")
        if value.get("references"):
            print("References:")
            for reference in value["references"]:
                print(f"- {reference}")
        if value.get("path"):
            print(f"Path: {value['path']}")
        return
    print(value)


def list_patterns(scope: str, language: str | None, as_json: bool) -> None:
    patterns = load_patterns()
    language_profiles = load_language_profiles()
    valid_scopes = scope_names(patterns)
    if scope not in valid_scopes:
        valid = ", ".join(sorted(valid_scopes))
        raise SystemExit(f"Unknown scope: {scope}. Valid scopes: {valid}")
    if language and language not in language_profiles:
        raise SystemExit(f"Unknown language: {language}")
    filtered = [
        attach_language(pattern, language, language_profiles)
        for pattern in patterns
        if matches_scope(pattern, scope) and (not language or language in pattern.get("languages", []))
    ]
    emit(filtered, as_json)


def search(query: str, scope: str, language: str | None, as_json: bool) -> None:
    patterns = load_patterns()
    language_profiles = load_language_profiles()
    valid_scopes = scope_names(patterns)
    if scope not in valid_scopes:
        valid = ", ".join(sorted(valid_scopes))
        raise SystemExit(f"Unknown scope: {scope}. Valid scopes: {valid}")
    if language and language not in language_profiles:
        raise SystemExit(f"Unknown language: {language}")

    needle = query.casefold()
    matches = []
    for pattern in patterns:
        if not matches_scope(pattern, scope):
            continue
        if language and language not in pattern.get("languages", []):
            continue
        haystack = entry_search_text(pattern)
        if needle in haystack:
            matches.append(attach_language(pattern, language, language_profiles))
    emit(matches, as_json)


def show(slug_or_name: str, language: str | None, as_json: bool) -> int:
    patterns = load_patterns()
    language_profiles = load_language_profiles()
    needle = slug_or_name.casefold()
    for pattern in patterns:
        names = {pattern["slug"].casefold(), pattern["name"].casefold()}
        if needle in names:
            try:
                value = attach_language(pattern, language, language_profiles)
            except ValueError as exc:
                print(str(exc), file=sys.stderr)
                return 1
            emit(value, as_json, language)
            return 0
    print(f"No pattern found for: {slug_or_name}", file=sys.stderr)
    return 1


def languages(language: str | None, as_json: bool) -> None:
    profiles = load_language_profiles()
    if language:
        if language not in profiles:
            raise SystemExit(f"Unknown language: {language}")
        emit(profiles[language], as_json)
        return
    emit({"languages": profiles}, as_json)


def domains(as_json: bool) -> None:
    entries = load_catalog()
    groups = sorted({group for entry in entries for group in entry.get("groups", [])})
    domain_data = {
        "groups": groups,
        "domains": sorted({entry["domain"] for entry in entries}),
    }
    emit(domain_data, as_json)


def show_collection(kind: str, slug_or_name: str | None, as_json: bool) -> int:
    entries = load_playbooks() if kind == "playbook" else load_smells()
    if slug_or_name is None:
        emit(entries, as_json)
        return 0
    needle = slug_or_name.casefold()
    for entry in entries:
        names = {entry["slug"].casefold(), entry["name"].casefold()}
        if needle in names:
            emit(entry, as_json)
            return 0
    print(f"No {kind} found for: {slug_or_name}", file=sys.stderr)
    return 1


def find_entry(slug_or_name: str) -> dict | None:
    needle = slug_or_name.casefold()
    for entry in load_catalog():
        names = {entry["slug"].casefold(), entry["name"].casefold()}
        if needle in names:
            return entry
    return None


def compare(slugs: list[str], as_json: bool) -> int:
    entries = []
    missing = []
    for slug in slugs:
        entry = find_entry(slug)
        if entry:
            entries.append(entry)
        else:
            missing.append(slug)
    if missing:
        print("No catalog entry found for: " + ", ".join(missing), file=sys.stderr)
        return 1
    if as_json:
        emit(entries, True)
        return 0
    for entry in entries:
        print(f"{entry.get('slug')}: {entry.get('name')} [{entry.get('kind')}]")
        if entry.get("intent"):
            print(f"  intent: {entry['intent']}")
        if entry.get("symptom"):
            print(f"  symptom: {entry['symptom']}")
        if entry.get("qualityAttributes"):
            print("  quality: " + ", ".join(entry["qualityAttributes"]))
        if entry.get("implementationComplexity"):
            print(f"  complexity: {entry['implementationComplexity']}")
        if entry.get("operationalRisk"):
            print(f"  operational risk: {entry['operationalRisk']}")
        if entry.get("tradeoffNotes"):
            print("  tradeoff: " + entry["tradeoffNotes"][0])
        if entry.get("avoidWhen"):
            print("  avoid: " + entry["avoidWhen"][0])
    return 0


def recommend(query: str, scope: str, language: str | None, limit: int, as_json: bool) -> None:
    language_profiles = load_language_profiles()
    if language and language not in language_profiles:
        raise SystemExit(f"Unknown language: {language}")
    terms = [term.casefold() for term in query.replace("-", " ").split() if len(term) > 2]
    entries = []
    for entry in load_catalog():
        if not matches_scope(entry, scope):
            continue
        if language and entry.get("kind") == "pattern" and language not in entry.get("languages", []):
            continue
        text = entry_search_text(entry)
        score = 0
        for term in terms:
            score += text.count(term)
        if query.casefold() in text:
            score += 5
        if score:
            enriched = attach_language(entry, language, language_profiles) if entry.get("kind") == "pattern" and language else entry
            recommendation = dict(enriched)
            recommendation["score"] = score
            entries.append(recommendation)
    entries.sort(key=lambda item: (-item["score"], item.get("kind", ""), item.get("slug", "")))
    emit(entries[:limit], as_json)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="Emit JSON")
    subparsers = parser.add_subparsers(dest="command", required=True)

    list_parser = subparsers.add_parser("list", help="List patterns")
    list_parser.add_argument("scope", nargs="?", default="all", help="all, a domain group, or a domain")
    list_parser.add_argument("--language", help="Filter to a language and add language-specific guidance")
    list_parser.add_argument("--json", action="store_true", dest="command_json", help="Emit JSON")

    show_parser = subparsers.add_parser("show", help="Show one pattern")
    show_parser.add_argument("slug_or_name")
    show_parser.add_argument("--language", help="Add language-specific guidance")
    show_parser.add_argument("--json", action="store_true", dest="command_json", help="Emit JSON")

    search_parser = subparsers.add_parser("search", help="Search patterns")
    search_parser.add_argument("query")
    search_parser.add_argument("--scope", default="all", help="all, a domain group, or a domain")
    search_parser.add_argument("--language", help="Filter to a language and add language-specific guidance")
    search_parser.add_argument("--json", action="store_true", dest="command_json", help="Emit JSON")

    languages_parser = subparsers.add_parser("languages", help="Show supported language profiles")
    languages_parser.add_argument("language", nargs="?")
    languages_parser.add_argument("--json", action="store_true", dest="command_json", help="Emit JSON")

    domains_parser = subparsers.add_parser("domains", help="Show domain groups and domains")
    domains_parser.add_argument("--json", action="store_true", dest="command_json", help="Emit JSON")

    playbooks_parser = subparsers.add_parser("playbooks", help="List or show architecture playbooks")
    playbooks_parser.add_argument("slug_or_name", nargs="?")
    playbooks_parser.add_argument("--json", action="store_true", dest="command_json", help="Emit JSON")

    smells_parser = subparsers.add_parser("smells", help="List or show architecture smells")
    smells_parser.add_argument("slug_or_name", nargs="?")
    smells_parser.add_argument("--json", action="store_true", dest="command_json", help="Emit JSON")

    compare_parser = subparsers.add_parser("compare", help="Compare catalog entries by slug or name")
    compare_parser.add_argument("slugs", nargs="+")
    compare_parser.add_argument("--json", action="store_true", dest="command_json", help="Emit JSON")

    recommend_parser = subparsers.add_parser("recommend", help="Recommend patterns, playbooks, and smells from a force description")
    recommend_parser.add_argument("query")
    recommend_parser.add_argument("--scope", default="all", help="all, a domain group, or a domain")
    recommend_parser.add_argument("--language", help="Filter pattern candidates to a language and add language-specific guidance")
    recommend_parser.add_argument("--limit", type=int, default=5, help="Maximum recommendations to show")
    recommend_parser.add_argument("--json", action="store_true", dest="command_json", help="Emit JSON")

    args = parser.parse_args()
    as_json = args.json or getattr(args, "command_json", False)
    if args.command == "list":
        list_patterns(args.scope, args.language, as_json)
        return 0
    if args.command == "show":
        return show(args.slug_or_name, args.language, as_json)
    if args.command == "search":
        search(args.query, args.scope, args.language, as_json)
        return 0
    if args.command == "languages":
        languages(args.language, as_json)
        return 0
    if args.command == "domains":
        domains(as_json)
        return 0
    if args.command == "playbooks":
        return show_collection("playbook", args.slug_or_name, as_json)
    if args.command == "smells":
        return show_collection("smell", args.slug_or_name, as_json)
    if args.command == "compare":
        return compare(args.slugs, as_json)
    if args.command == "recommend":
        recommend(args.query, args.scope, args.language, args.limit, as_json)
        return 0
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
