#!/usr/bin/env python3
"""Search the bundled design-pattern catalogs."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
DATA = ROOT / "data"


def load_json(name: str) -> dict:
    with (DATA / name).open("r", encoding="utf-8") as handle:
        return json.load(handle)


def all_patterns() -> list[dict]:
    gof = load_json("gof.json")["patterns"]
    eip = load_json("eip.json")["patterns"]
    return [{**pattern, "catalog": "gof"} for pattern in gof] + [
        {**pattern, "catalog": "eip"} for pattern in eip
    ]


def emit(value: object, as_json: bool) -> None:
    if as_json:
        print(json.dumps(value, indent=2, sort_keys=True))
        return
    if isinstance(value, list):
        for item in value:
            if isinstance(item, dict):
                print(f"{item.get('slug')}: {item.get('name')} [{item.get('catalog', item.get('category'))}]")
            else:
                print(item)
        return
    if isinstance(value, dict):
        print(f"{value.get('name')} ({value.get('slug')})")
        if value.get("catalog"):
            print(f"Catalog: {value['catalog']}")
        if value.get("family"):
            print(f"Family: {value['family']}")
        if value.get("category"):
            print(f"Category: {value['category']}")
        if value.get("intent"):
            print(f"Intent: {value['intent']}")
        if value.get("whenToUse"):
            print("When to use:")
            for item in value["whenToUse"]:
                print(f"- {item}")
        if value.get("avoidWhen"):
            print("Avoid when:")
            for item in value["avoidWhen"]:
                print(f"- {item}")
        if value.get("related"):
            print("Related: " + ", ".join(value["related"]))
        return
    print(value)


def list_patterns(catalog: str, as_json: bool) -> None:
    if catalog == "gof":
        patterns = [{**pattern, "catalog": "gof"} for pattern in load_json("gof.json")["patterns"]]
    elif catalog == "eip":
        patterns = [{**pattern, "catalog": "eip"} for pattern in load_json("eip.json")["patterns"]]
    else:
        patterns = all_patterns()
    emit(patterns, as_json)


def search(query: str, as_json: bool) -> None:
    needle = query.casefold()
    matches = []
    for pattern in all_patterns():
        haystack = " ".join(
            str(pattern.get(field, ""))
            for field in ("slug", "name", "family", "category", "intent")
        ).casefold()
        if needle in haystack:
            matches.append(pattern)
    emit(matches, as_json)


def show(slug_or_name: str, as_json: bool) -> int:
    needle = slug_or_name.casefold()
    for pattern in all_patterns():
        names = {pattern["slug"].casefold(), pattern["name"].casefold()}
        if needle in names:
            emit(pattern, as_json)
            return 0
    print(f"No pattern found for: {slug_or_name}", file=sys.stderr)
    return 1


def languages(as_json: bool) -> None:
    emit(load_json("languages.json"), as_json)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="Emit JSON")
    subparsers = parser.add_subparsers(dest="command", required=True)

    list_parser = subparsers.add_parser("list", help="List patterns")
    list_parser.add_argument("catalog", choices=["all", "gof", "eip"], nargs="?", default="all")

    show_parser = subparsers.add_parser("show", help="Show one pattern")
    show_parser.add_argument("slug_or_name")

    search_parser = subparsers.add_parser("search", help="Search patterns")
    search_parser.add_argument("query")

    subparsers.add_parser("languages", help="Show supported language notes")

    args = parser.parse_args()
    if args.command == "list":
        list_patterns(args.catalog, args.json)
        return 0
    if args.command == "show":
        return show(args.slug_or_name, args.json)
    if args.command == "search":
        search(args.query, args.json)
        return 0
    if args.command == "languages":
        languages(args.json)
        return 0
    return 1


if __name__ == "__main__":
    raise SystemExit(main())

